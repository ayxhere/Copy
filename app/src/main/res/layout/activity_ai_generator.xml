<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back"
                android:tint="@color/text_primary" android:contentDescription="Back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/ai_generator" android:textColor="@color/text_primary"
                android:textSize="22sp" android:textStyle="bold" android:layout_marginStart="12dp" />
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_spark" android:tint="@color/accent" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ai_groq_default" android:textColor="@color/accent"
            android:textSize="11sp" android:layout_marginStart="52dp" android:layout_marginBottom="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ai_triggers_hint" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="16dp" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipAiImprove" style="@style/CopyMe.Chip"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/ai_improve" android:checked="true" android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipAiEnglish" style="@style/CopyMe.Chip"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/ai_english" android:layout_marginEnd="8dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipAiRoman" style="@style/CopyMe.Chip"
                android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/ai_roman" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/CopyMe.TextInput" android:layout_marginTop="16dp" android:hint="@string/ai_input_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="15sp"
                android:inputType="textMultiLine" android:minLines="4" android:maxLines="10" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGenerate"
            android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/ai_generate"
            android:textSize="16sp" android:textStyle="bold" android:backgroundTint="@color/accent"
            android:textColor="@color/black" app:cornerRadius="16dp" android:layout_marginTop="16dp" />
        <ProgressBar android:id="@+id/progressAi" android:layout_width="match_parent" android:layout_height="4dp"
            android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Result"
            android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/tvOutput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:padding="16dp" android:textColor="@color/text_primary"
            android:textSize="15sp" android:lineSpacingExtra="3dp" android:minHeight="120dp"
            android:text="@string/ai_output_hint" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCopy"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/ai_copy_result"
                android:backgroundTint="@color/card" android:textColor="@color/text_primary" app:cornerRadius="14dp" android:layout_marginEnd="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveAsCommand"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/ai_save_as_command"
                style="@style/Widget.Material3.Button.OutlinedButton" android:textColor="@color/accent" app:strokeColor="@color/accent" app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
